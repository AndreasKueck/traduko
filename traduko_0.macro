0","m_triggerList":[{"disableLogging":false,"m_SIGUID":-6676535337724194536,"m_classType":"EmptyTrigger","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false}]},"macroExportVersion":1}