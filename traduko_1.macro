lplenigataj che chiu denova startigo de tiu chi makroo.\nPor chio chi la uzanto jam antaue devas esti\n- kreinta dosierujon nome \"dosierujo\" kaj krome\n- anstatauiginta la shablonajn OpenAI-API-shlosilojn per validaj en makroo traduko_2.","m_descriptionOpen":false,"m_enabled":true,"m_excludeLog":false,"m_headingColor":0,"m_isOrCondition":false,"m_name":"traduko_1","m_triggerList":[{"disableLogging":false,"m_SIGUID":-6324487701526702151,"m_classType":"EmptyTrigger","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false}]},"macroExportVersion":1}
